# Vouch — environment variables
# Copy to .env.local for local dev. In production (e.g. Vercel) set these in the
# project's Environment Variables. Only the SUPABASE_* pair is required; the rest
# enable optional sign-on channels an admin can turn on per community.

# ── Database (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# ── Where magic-link claim links point ───────────────────────────────────────
# Your deployed origin in production; defaults to http://localhost:3000 if unset.
APP_URL=https://<your-deployment>

# ── Email sign-on (magic links via Resend) ───────────────────────────────────
# Without these, sign-in emails are logged to the server console instead of sent.
# RESEND_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=re_<your-key>
RESEND_FROM=Vouch <noreply@yourdomain.com>

# ── Phone sign-on (SMS magic links via Twilio) ───────────────────────────────
# Without these, sign-in texts are logged to the server console instead of sent.
# TWILIO_FROM may be a phone number or a Messaging Service SID (starts with MG).
TWILIO_ACCOUNT_SID=<your-account-sid>
TWILIO_AUTH_TOKEN=<your-auth-token>
TWILIO_FROM=<your-twilio-number-or-messaging-service-sid>
